# 复制为 .env.nas 后填写真实值，不要把 .env.nas 提交到 Git

# 绿联 NAS 上已有的 PostgreSQL（必须启用 pgvector）
POSTGRES_HOST=192.168.100.151
POSTGRES_PORT=35432
POSTGRES_DB=interview_guide
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me

# 绿联 NAS 上已有的 Redis
REDIS_HOST=192.168.100.151
REDIS_PORT=36379

# 绿联 NAS 上已有的 MinIO
# 使用 MinIO 的 API 端口，不是控制台端口；容器内不能写 localhost
APP_STORAGE_ENDPOINT=http://192.168.100.151:9000
APP_STORAGE_ACCESS_KEY=minioadmin
APP_STORAGE_SECRET_KEY=change_me
APP_STORAGE_BUCKET=interview-guide
APP_STORAGE_REGION=us-east-1
APP_STORAGE_AUTO_CREATE_BUCKET=true

# AI 配置
AI_BAILIAN_API_KEY=your_dashscope_api_key
# 生产环境请使用随机长字符串；已有加密 Provider 配置时不要更换
APP_AI_CONFIG_ENCRYPTION_KEY=change_me_to_a_random_long_secret
AI_MODEL=qwen3.5-flash

# 应用端口
APP_PORT=8080
FRONTEND_PORT=8088
CORS_ALLOWED_ORIGINS=http://192.168.100.151:8088

# 面试参数
APP_INTERVIEW_FOLLOW_UP_COUNT=1
APP_INTERVIEW_EVALUATION_BATCH_SIZE=8

# JVM 参数，根据 NAS 内存调整
JAVA_OPTS=-Xms512m -Xmx1024m
